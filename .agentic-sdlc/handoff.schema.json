{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barucoh/agentic-sdlc/schemas/handoff-1.0.0.json",
  "title": "Agentic SDLC structured handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "from_role",
    "to_role",
    "work_item",
    "target_model",
    "effort",
    "rationale",
    "execution_mode",
    "sandbox_mode",
    "is_correction",
    "lifecycle_state",
    "lifecycle_event",
    "source_task_key",
    "target_task_key",
    "readiness_evidence",
    "objective",
    "inputs",
    "constraints",
    "adrs",
    "acceptance_criteria",
    "outputs",
    "dependencies",
    "escalation",
    "evidence",
    "residual_risk",
    "terminal_state"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from_role": { "$ref": "#/$defs/role" },
    "to_role": { "$ref": "#/$defs/role" },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue_number", "issue_url", "title"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "pull_request_url": { "type": ["string", "null"], "format": "uri" },
        "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      },
      "oneOf": [
        { "properties": { "pull_request_url": { "type": "null" }, "commit_sha": { "type": "null" } } },
        { "required": ["pull_request_url", "commit_sha"], "properties": { "pull_request_url": { "type": "string", "format": "uri" }, "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } } }
      ]
    },
    "objective": { "type": "string", "minLength": 1 },
    "target_model": {
      "type": "string",
      "enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
    },
    "effort": {
      "type": "string",
      "enum": ["Low", "Medium", "High"]
    },
    "rationale": { "type": "string", "minLength": 1, "pattern": "^[^.!?\\r\\n]+[.!?]$" },
    "execution_mode": {
      "type": "string",
      "enum": ["durable", "ephemeral_research"]
    },
    "sandbox_mode": {
      "type": "string",
      "enum": ["read-only", "workspace-write"]
    },
    "is_correction": { "type": "boolean" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["IMPLEMENTATION_ACTIVE", "IMPLEMENTATION_READY", "REVIEW_ACTIVE", "CHANGES_REQUESTED", "CORRECTION_ACTIVE", "REVIEW_ACCEPTED", "HUMAN_MERGE_READY", "BLOCKED", "DELIVERY_UNKNOWN"]
    },
    "lifecycle_event": { "type": "string", "enum": ["IMPLEMENTATION_READY", "REVIEW_ACTIVATE", "CHANGES_REQUESTED", "CORRECTION_ACTIVATE", "REVIEW_ACCEPTED", "HUMAN_MERGE_READY", "BLOCKED"] },
    "source_task_key": { "type": "string", "pattern": "^issue-[1-9][0-9]*-[a-z][a-z0-9-]*$" },
    "target_task_key": { "type": "string", "pattern": "^issue-[1-9][0-9]*-[a-z][a-z0-9-]*$" },
    "readiness_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_sha", "pull_request_url", "local_gates", "ci_status", "required_checks"],
      "properties": {
        "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "pull_request_url": { "type": ["string", "null"], "format": "uri" },
        "local_gates": { "type": "string", "enum": ["passed", "failed", "pending", "not_run"] },
        "ci_status": { "type": "string", "enum": ["passed", "failed", "pending", "not_run"] },
        "required_checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": { "name": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["passed", "failed", "pending", "not_run"] } } }, "uniqueItems": true }
      }
    },
    "blocked_fallback": { "type": ["object", "null"], "additionalProperties": false, "properties": {
      "repository": { "type": "string", "minLength": 1 }, "issue_url": { "type": "string", "format": "uri" },
      "operation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "issue_or_pr_url": { "type": "string", "pattern": "^https://" }, "objective": { "type": "string", "minLength": 1 },
      "expected_output": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 }, "next_owner": { "type": "string", "minLength": 1 }
    } },
    "watchdog_seconds": { "type": "integer", "minimum": 20, "maximum": 30 },
    "inputs": { "$ref": "#/$defs/stringList" },
    "constraints": { "$ref": "#/$defs/stringList" },
    "adrs": { "$ref": "#/$defs/stringList" },
    "acceptance_criteria": { "$ref": "#/$defs/stringList" },
    "outputs": { "$ref": "#/$defs/stringList" },
    "dependencies": { "$ref": "#/$defs/stringList" },
    "escalation": { "$ref": "#/$defs/stringList" },
    "evidence": { "$ref": "#/$defs/stringList" },
    "residual_risk": { "$ref": "#/$defs/stringList" },
    "terminal_state": {
      "type": "string",
      "enum": ["completed", "changes_requested", "blocked"]
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "enum": ["coordinator", "product", "architecture", "implementation", "qa", "reviewer", "knowledge_steward", "human_owner"]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
